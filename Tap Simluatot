local function doClick()
	-- click / race click remotes
	fireKeyword({ "click", "tap", "raceclick", "addclick" })
	fireKeyword({ "click" }, 1)

	-- VirtualUser click as fallback
	pcall(function()
		VU:CaptureController()
		VU:ClickButton1(Vector2.new(0, 0))
	end)
end

local function doRace()
	fireKeyword({ "race", "startrace", "beginrace", "joinrace", "start" })
	fireKeyword({ "race" }, "start")
	fireKeyword({ "race" }, true)

	-- prompts / buttons related to race
	if not root then refreshChar() end
	if not root then return end

	for _, v in ipairs(WS:GetDescendants()) do
		if v:IsA("ProximityPrompt") and v.Enabled then
			local label = string.lower(v.Name .. " " .. (v.Parent and v.Parent.Name or ""))
			if string.find(label, "race", 1, true)
				or string.find(label, "start", 1, true)
				or string.find(label, "join", 1, true) then
				local part = v.Parent and (v.Parent:IsA("BasePart") and v.Parent or v.Parent:FindFirstChildWhichIsA("BasePart"))
				if part then
					local okDist, dist = pcall(function() return (part.Position - root.Position).Magnitude end)
					if okDist and dist and dist < 40 then
						firePrompt(v)
					end
				end
			end
		end
	end
end

local function doRebirth()
	fireKeyword({ "rebirth", "prestige", "reset" })
	fireKeyword({ "rebirth" }, true)
	fireKeyword({ "rebirth" }, "rebirth")
end

