		WindUI:Notify({ Title = title or "SL HUB", Content = content or "", Duration = dur or 3 })
	end)
end

local function setStatus(t)
	StatusText = tostring(t)
end

local function firePrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return end
	pcall(function()
		if fireproximityprompt then
			fireproximityprompt(prompt)
		else
			prompt:InputHoldBegin()
			task.wait(math.min(prompt.HoldDuration or 0.05, 0.25))
			prompt:InputHoldEnd()
		end
	end)
end

local function touchPart(part)
	if not root or not part or not part:IsA("BasePart") then return end
	if not firetouchinterest then return end
	pcall(function()
		firetouchinterest(root, part, 0)
		firetouchinterest(root, part, 1)
	end)
end

local remoteCache = {}
local function findRemotes(keywords)
	local key = table.concat(keywords, "|")
	if remoteCache[key] then return remoteCache[key] end
	local list = {}
	pcall(function()
		for _, v in ipairs(RS:GetDescendants()) do
			if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
				local n = string.lower(v.Name)
				for _, k in ipairs(keywords) do
					if string.find(n, string.lower(k), 1, true) then
						table.insert(list, v)
						break
					end
				end
			end
		end
		-- also check common folders
		for _, folderName in ipairs({ "Events", "Remotes", "Network", "RemoteEvents" }) do
			local folder = RS:FindFirstChild(folderName)
			if folder then
				for _, v in ipairs(folder:GetDescendants()) do
					if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
						local n = string.lower(v.Name)
						for _, k in ipairs(keywords) do
							if string.find(n, string.lower(k), 1, true) then
								table.insert(list, v)
								break
							end
						end
					end
				end
			end
		end
	end)
	remoteCache[key] = list
	return list
end

local function fireKeyword(keywords, ...)
	local args = { ... }
	for _, rem in ipairs(findRemotes(keywords)) do
		pcall(function()
			if rem:IsA("RemoteEvent") then
				rem:FireServer(table.unpack(args))
			elseif rem:IsA("RemoteFunction") then
				rem:InvokeServer(table.unpack(args))
			end
		end)
	end
end

